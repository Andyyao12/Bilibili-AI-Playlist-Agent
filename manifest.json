{
  "manifest_version": 3,
  "name": "Bilibili AI Playlist Agent",
  "version": "0.1.0",
  "description": "Natural-language video discovery and continuous playback for Bilibili. Bring your own OpenAI-compatible LLM.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "sidePanel", "scripting", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Bilibili AI Playlist Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://search.bilibili.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
