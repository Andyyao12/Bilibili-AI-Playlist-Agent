{
  "name": "bilibili-ai-playlist-agent",
  "version": "0.1.0",
  "private": true,
  "description": "用自然语言描述想听的内容，由你自己配置的 OpenAI-compatible LLM 在 Bilibili 自动搜索、排序并连续播放。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "verify:llm": "esbuild scripts/verify-llm.ts --bundle --platform=node --format=esm --target=node22 --outfile=node_modules/.cache/bapa/verify-llm.mjs && node node_modules/.cache/bapa/verify-llm.mjs",
    "verify:llm:report": "esbuild scripts/verify-llm.ts --bundle --platform=node --format=esm --target=node22 --outfile=node_modules/.cache/bapa/verify-llm.mjs && node node_modules/.cache/bapa/verify-llm.mjs --out verify-llm-report.log"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "0.0.287",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
